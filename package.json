{
  "name": "nerdybirdy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "copy-pdf-worker": "node -e \"require('fs').copyFileSync('node_modules/pdfjs-dist/legacy/build/pdf.worker.min.mjs','public/pdf.worker.min.mjs')\"",
    "predev": "npm run copy-pdf-worker",
    "prebuild": "npm run copy-pdf-worker",
    "build:server": "esbuild server/server.ts --bundle --platform=node --target=node22 --format=cjs --conditions=react-server --outfile=server/dist/server.js --log-level=warning",
    "dev:server": "npm run build:server && node --env-file-if-exists=.env server/dist/server.js",
    "test": "tsx --conditions=react-server --test tests/*.test.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.40.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "next": "16.4.2",
    "openai": "^7.36.0",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
