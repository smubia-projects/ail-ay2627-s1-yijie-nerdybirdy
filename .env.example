# NerdyBirdy API (server/, Cloud Run): copy to .env and fill in. Never commit real values.
# The deploy uploads .env as the repo's DOTENV secret (gh secret set DOTENV < .env).

# Inference gateway (OpenAI-compatible). API_KEY: this project's own key from the AI Lodge key bot.
# The original names (OPENROUTER_API_KEY, MODEL_PROFESSOR, MODEL_CHECKER, MODEL_EMBED) still work as fallbacks.
API_BASE_URL=https://api.apiyi.com/v1
API_KEY=
# The professor: answers, topic maps, question generation, grading, study notes.
MODEL_NAME=deepseek-v4-1-flash-260910
# The checker that verifies every quiz question before it is shown. The student's original ran both roles on
# DeepSeek V4.1 Flash; the AI Lodge default (deepseek-v4-1-flash-260910) is the same model on the club gateway.
CHECKER_MODEL_NAME=deepseek-v4-1-flash-260910
# Embeddings, always requested at 768 dims (the pgvector column).
EMBEDDING_MODEL_NAME=text-embedding-3-small

# Neon Postgres with pgvector, e.g. postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# The API creates its tables on first use.
DATABASE_URL=

# The Vercel site's origin(s), comma-separated (vercel-setup.sh sets the real one).
CORS_ORIGINS=http://localhost:3000

# Uploaded notes (and everything built from them) are deleted this many hours after upload.
NOTES_TTL_HOURS=24

# Shared AI Lodge rate limiter: per-IP fallbacks when the central sheet has no row.
# The Upstash keys come from the batch's shared env, not this file.
RATE_LIMIT_ASK_MAX=10
RATE_LIMIT_QUIZ_MAX=10
RATE_LIMIT_GRADE_MAX=10
RATE_LIMIT_NOTES_MAX=5
RATE_LIMIT_UPLOAD_MAX=3
RATE_LIMIT_WINDOW_SECONDS=432000
